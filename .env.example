# Database (asyncpg requires postgresql+asyncpg://)
# Local Docker: postgresql+asyncpg://postgres:postgrespassword@localhost:5432/dialecto
# Neon (Prod): postgresql+asyncpg://user:pass@ep-xyz.neon.tech/dialecto?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/dialecto

# Groq AI
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_PRIMARY_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant
WHISPER_MODEL=whisper-large-v3-turbo
LLM_TIMEOUT_S=15

# Server & Network
PORT=8000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Observability & Environment
LOG_LEVEL=INFO
ENV=development


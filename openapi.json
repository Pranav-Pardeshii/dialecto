{
  "openapi": "3.1.0",
  "info": {
    "title": "Dialecto API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health & Readiness"
        ],
        "summary": "Health Check",
        "description": "Fast liveness probe with zero external dependencies.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "Health & Readiness"
        ],
        "summary": "Readiness Check",
        "description": "Readiness probe checking database connectivity and configuration sanity.",
        "operationId": "readiness_check_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users": {
      "get": {
        "tags": [
          "Identity"
        ],
        "summary": "List Users",
        "description": "List available demo identities for the role switcher.",
        "operationId": "list_users_api_v1_users_get",
        "parameters": [
          {
            "name": "include_simulated",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Include simulated demo students",
              "default": false,
              "title": "Include Simulated"
            },
            "description": "Include simulated demo students"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserOut"
                  },
                  "title": "Response List Users Api V1 Users Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "Identity"
        ],
        "summary": "Get Me",
        "description": "Return the currently authenticated demo identity from X-Demo-User-Id.",
        "operationId": "get_me_api_v1_me_get",
        "parameters": [
          {
            "name": "X-Demo-User-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Demo-User-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/concepts": {
      "get": {
        "tags": [
          "Concepts"
        ],
        "summary": "Get Concept Graph",
        "description": "Retrieve full concept graph (nodes with mastery and directed prerequisite edges).",
        "operationId": "get_concept_graph_api_v1_concepts_get",
        "parameters": [
          {
            "name": "X-Demo-User-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Demo-User-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConceptGraphResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/concepts/{concept_id}": {
      "get": {
        "tags": [
          "Concepts"
        ],
        "summary": "Get Concept Detail",
        "description": "Retrieve individual concept details and lesson markdown (excludes rubric key points).",
        "operationId": "get_concept_detail_api_v1_concepts__concept_id__get",
        "parameters": [
          {
            "name": "concept_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Concept Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConceptDetailResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ConceptDetailResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "chapter": {
            "type": "string",
            "title": "Chapter"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "lesson_md": {
            "type": "string",
            "title": "Lesson Md"
          },
          "prerequisites": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Prerequisites"
          },
          "misconception_count": {
            "type": "integer",
            "title": "Misconception Count"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "chapter",
          "description",
          "lesson_md",
          "prerequisites",
          "misconception_count"
        ],
        "title": "ConceptDetailResponse"
      },
      "ConceptEdge": {
        "properties": {
          "from": {
            "type": "string",
            "title": "From"
          },
          "to": {
            "type": "string",
            "title": "To"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "title": "ConceptEdge"
      },
      "ConceptGraphResponse": {
        "properties": {
          "nodes": {
            "items": {
              "$ref": "#/components/schemas/ConceptNode"
            },
            "type": "array",
            "title": "Nodes"
          },
          "edges": {
            "items": {
              "$ref": "#/components/schemas/ConceptEdge"
            },
            "type": "array",
            "title": "Edges"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "nodes",
          "edges"
        ],
        "title": "ConceptGraphResponse"
      },
      "ConceptMasterySummary": {
        "properties": {
          "p_effective": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "P Effective"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "p_effective",
          "status"
        ],
        "title": "ConceptMasterySummary"
      },
      "ConceptNode": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "chapter": {
            "type": "string",
            "title": "Chapter"
          },
          "position": {
            "type": "integer",
            "title": "Position"
          },
          "mastery": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConceptMasterySummary"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "chapter",
          "position"
        ],
        "title": "ConceptNode"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "HealthResponse"
      },
      "ReadyResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "default": "ok"
          },
          "database": {
            "type": "string",
            "title": "Database",
            "default": "connected"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "primary_model": {
            "type": "string",
            "title": "Primary Model"
          },
          "available_fallback_models": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Available Fallback Models"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "environment",
          "primary_model",
          "available_fallback_models"
        ],
        "title": "ReadyResponse"
      },
      "UserOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "is_simulated": {
            "type": "boolean",
            "title": "Is Simulated",
            "default": false
          },
          "classroom_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Classroom Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "display_name",
          "role"
        ],
        "title": "UserOut"
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "student",
          "teacher"
        ],
        "title": "UserRole"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
